let purchaseSerial=0;
async function loadPurchases(refresh=false){
 const serial=++purchaseSerial,el=$('#purchaseBooks');
 if(!(session.yes24||{}).loggedIn){fail(el,'앱 설정에서 YES24 계정으로 로그인하면 eBook 구매내역을 확인할 수 있습니다.');return;}
 loading(el);$('#purchaseSync').disabled=true;
 try{
  const result=await rpc('purchases',{refresh});if(serial!==purchaseSerial)return;
  const books=result.books||[];el.replaceChildren();
  $('#purchaseInfo').textContent='전체 '+(result.total_count??books.length)+'권 · '+(refresh?'방금 새로고침':'저장된 구매내역');
  if(!books.length){fail(el,refresh?'구매한 eBook이 없습니다.':'새로고침을 눌러 구매내역을 불러오세요.');return;}
  for(const b of books){
   const card=document.createElement('article');card.className='book purchaseBook';
   const normalizeImage=u=>String(u||'').replace(/^\/\//,'https://').replace(/^http:/i,'https:');
   const imageCandidates=[normalizeImage(b.thumbnail_url),b.product_code&&'https://image.yes24.com/goods/'+encodeURIComponent(b.product_code)+'/L',b.ebook_code&&'https://image.yes24.com/goods/'+encodeURIComponent(b.ebook_code)+'/L',b.product_code&&'https://image.yes24.com/goods/'+encodeURIComponent(b.product_code)+'/XL'].filter((v,i,a)=>v&&a.indexOf(v)===i);
   const image=imageCandidates.shift()||'';
   card.innerHTML='<span class="cover"><img loading="lazy" src="'+escapeHTML(image)+'" alt="'+escapeHTML(b.title)+' 표지"></span><span class="name">'+escapeHTML(b.title)+'</span><span class="author">'+escapeHTML(b.author_name||'')+'</span><button class="primary purchaseDownload">바로 다운로드</button>';
   card.querySelector('img').onerror=e=>{const next=imageCandidates.shift();if(next)e.target.src=next;else e.target.style.opacity='.2';};
   card.querySelector('button').onclick=()=>downloadPurchase(b,card.querySelector('button'));el.append(card);
  }
 }catch(e){if(serial===purchaseSerial)fail(el,e,()=>loadPurchases(true));}
 finally{if(serial===purchaseSerial)$('#purchaseSync').disabled=false;}
}
async function downloadPurchase(book,button){
 if(downloadBusy){toast('진행 중인 다운로드가 끝난 뒤 다시 시도해주세요.');return;}
 button.disabled=true;
 try{const result=await rpc('purchaseDownload',{id:String(book.ebook_code)});if(result.started){downloadBusy=true;toast('“'+book.title+'” 다운로드를 시작합니다.');}}
 catch(e){toast(e.message);button.disabled=false;}
}
$('#purchaseSync').onclick=()=>loadPurchases(true);

 private fun clearSpeechHighlight(){speechHighlightEpoch++;web?.clearMatches()}
 private fun highlightSpeechPart(){
  val view=web?:return
  if(!pageReady||!ttsPlaying)return
  val query=speechParts.getOrNull(speechPart)?.replace(Regex("\\s+")," ")?.trim()?.take(64).orEmpty()
  if(query.length<4){clearSpeechHighlight();return}
  val epoch=++speechHighlightEpoch
  view.findAllAsync(query)
  view.postDelayed({
   if(finished||!ttsPlaying||epoch!=speechHighlightEpoch||web!==view||view.width<=0)return@postDelayed
   val next=(view.scrollX/view.width).coerceIn(0,(chapterPages.getOrNull(page)?:1)-1)
   if(next!=spreadIndex){spreadIndex=next;savePage();updateProgress()}
  },300)
 }
 private fun ensureSpeechEngine(after:()->Unit){
  if(ttsMode=="android"){ensureTts(after);return}
  if(aiVoice==null)aiVoice=AiVoiceEngine(this,{advanceSpeech()},{message->stopSpeaking();Toast.makeText(this,message,Toast.LENGTH_LONG).show()})
  aiVoice?.prepare(when(ttsMode){"ridi"->"ridi";"willa"->"willa";else->"yes24"}){if(it)after()}
 }
 private fun updateListeningAction(){listeningAction?.text=if(ttsPlaying)"일시정지" else "재생"}
 private fun stopSpeaking(){ttsPlaying=false;updateListeningAction();clearSpeechHighlight();speechSequence++;speechPreparedPage=-1;tts?.stop();aiVoice?.stop()}
 private fun pauseSpeaking(){ttsPlaying=false;updateListeningAction();clearSpeechHighlight();speechSequence++;tts?.stop();aiVoice?.stop()}
 private fun speakPart(){
  if(!ttsPlaying||speechPart !in speechParts.indices)return
  if(timerDeadline>0&&System.currentTimeMillis()>=timerDeadline){stopSpeaking();return}
  highlightSpeechPart()
  if(ttsMode!="android")aiVoice?.play(speechParts[speechPart],when(ttsMode){"ridi"->ridiVoiceIndex;"willa"->willaVoiceIndex;else->aiVoiceIndex},ttsRate,ttsPitch,ttsReadParentheses,ttsSkipHanja)
  else {
   if(speechEnglish.getOrNull(speechPart)==true)tts?.language=Locale.US else applyTtsOptions()
   tts?.speak(speechParts[speechPart],TextToSpeech.QUEUE_FLUSH,null,"$speechSequence:$speechPart")
  }
 }
 private fun startSpeaking(){
  if(format!="epub"){Toast.makeText(this,"PDF 듣기는 이 뷰어에서 지원되지 않습니다.",Toast.LENGTH_LONG).show();return}
  ensureSpeechEngine {
   if(speechPreparedPage==page&&speechParts.isNotEmpty()){
    speechSequence++;ttsPlaying=true;updateListeningAction();speakPart();return@ensureSpeechEngine
   }
   stopSpeaking();val request=++speechSequence;ttsPlaying=true;updateListeningAction()
   val chapter=spine.getOrNull(page)?:return@ensureSpeechEngine
   worker.execute{
    val text=try{
     val entry=zip?.getEntry(chapter)?:throw IllegalArgumentException()
     if(entry.size>2_000_000L)throw IllegalArgumentException()
     val html=zip!!.getInputStream(entry).bufferedReader().use{it.readText()}
     var spoken=Html.fromHtml(html.replace(Regex("(?is)<(script|style)[^>]*>.*?</\\1>"),""),Html.FROM_HTML_MODE_LEGACY).toString()
     if(!ttsReadParentheses)spoken=spoken.replace(Regex("\\([^)]*\\)|（[^）]*）"),"")
     if(ttsSkipHanja)spoken=spoken.replace(Regex("[\\u4e00-\\u9fff]+"),"")
     spoken.replace(Regex("[\\t ]+")," ").trim()
    }catch(_:Exception){""}
    val prepared=ArrayList<Pair<String,Boolean>>()
    for(clause in text.split(Regex("(?<=[.!?。])\\s+|\\n+"))){
     if(clause.isBlank())continue
     val english=ttsAutoLanguage&&clause.count{it in 'A'..'Z'||it in 'a'..'z'}>=8&&clause.count{it in '가'..'힣'}*2<clause.length
     for(part in clause.trim().chunked(350))prepared.add(part to english)
    }
    mainHandler.post{
     if(!finished&&ttsPlaying&&request==speechSequence){
      speechParts=prepared.filter{it.first.isNotBlank()}.map{it.first}
      speechEnglish=prepared.filter{it.first.isNotBlank()}.map{it.second}
      speechPart=0;speechPreparedPage=page
      if(speechParts.isEmpty()){stopSpeaking();Toast.makeText(this,"읽을 본문이 없습니다.",Toast.LENGTH_SHORT).show()}else speakPart()
     }
    }
   }
  }
 }
